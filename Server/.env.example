# Copy to .env locally. Never commit .env or put API_KEY into Unity.
MODE=mock
PORT=8787
# AI mode requires both API_KEY and a model supported by your provider.
API_KEY=
MODEL=
API_BASE_URL=https://api.openai.com/v1/
# Voice is independent of dialogue MODE: mock dialogue + real voice is allowed.
# Audio and text are sent to API_BASE_URL when voice is enabled.
VOICE_MODE=disabled
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
